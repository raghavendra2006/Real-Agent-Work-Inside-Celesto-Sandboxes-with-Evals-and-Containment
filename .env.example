# Celesto sandbox configuration
CELESTO_PROVIDER=local
CELESTO_API_KEY=your-celesto-api-key-here
CELESTO_BACKEND=auto

# LLM configuration (OpenAI-compatible)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=llama3.2

# Database
DATABASE_URL=postgresql://celesto:celesto@ledger:5432/celesto

# API
API_PORT=8080

# Postgres (used by docker-compose for ledger service)
POSTGRES_USER=celesto
POSTGRES_PASSWORD=celesto
POSTGRES_DB=celesto

# Fault injection (set to "true" to trigger step-7 failure in demo)
FAULT_INJECT_STEP7=false

# Max LLM tokens per detonation run
LLM_MAX_TOKENS_PER_RUN=4096
